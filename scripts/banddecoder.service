[Unit]
Description=Dual Band Decoder - Ham Radio Station Controller
Documentation=https://github.com/francescocozzi/banddecoder
After=network.target

[Service]
Type=simple
User=io7t
Group=io7t
WorkingDirectory=/home/io7t/banddecoder
Environment="PYTHONUNBUFFERED=1"

# Main band decoder service
ExecStart=/home/io7t/banddecoder/venv/bin/python /home/io7t/banddecoder/src/band_decoder.py

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=banddecoder

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
